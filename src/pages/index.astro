---
import Base from '../layouts/Base.astro';
import HeroFoto from '../components/HeroFoto.astro';
import LeafEdge from '../components/LeafEdge.astro';
import Venster from '../components/Venster.astro';
import Icoon from '../components/Icoon.astro';
import Ervaringen from '../components/Ervaringen.astro';
import home from '../content/home.json';
// Stockfoto: Unsplash (photo VT8FA8ExqLs, Unsplash-licentie), wortels om een rotsblok
import introBeeld from '../assets/intro-wortels.webp';
import portret from '../assets/tarra-portret.webp';
import ceremonies from '../content/ceremonies.json';

const { hero, intro, waarom, cta } = home;

const pijl = '<svg viewBox="0 0 48 48" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 24h30M28 14c3 5 7 8 11 10-4 2-8 5-11 10"/></svg>';
---
<Base titel={home.seo.titel} beschrijving={home.seo.beschrijving}>
  <svg data-wortellijn class="pointer-events-none absolute left-0 top-0 z-[5]" aria-hidden="true"></svg>

  <!-- 1. Hero met foto -->
  <section class="relative isolate flex items-center overflow-hidden bg-woud-950 pb-12 pt-28 md:min-h-[64svh] md:pb-20 md:pt-32 lg:min-h-[70svh]" aria-labelledby="hero-kop" data-knoop="start">
    <HeroFoto />
    <div class="container-woud relative">
      <div class="max-w-[44rem]">
        <h1 id="hero-kop" class="text-[clamp(2.35rem,4.4vw,3.9rem)] leading-[1.1] text-dauw-50">{hero.kop}</h1>
        <p class="mt-8 max-w-[52ch] text-[1.0625rem] leading-[1.75] text-dauw-200 md:text-[1.1875rem]">{hero.tekst}</p>
        <div class="mt-11 flex flex-wrap items-center gap-x-8 gap-y-5">
          <a href="/contact/" class="knop knop-zon">{hero.knop}<Fragment set:html={pijl} /></a>
          <a href="/ceremonies/" class="tekstlink text-lg">{hero.link}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Introductie: tekst links voor rust, sfeerbeeld rechts. Nathalie's portret en verhaal komen later op de pagina. -->
  <section class="relative bg-woud-800 pb-24 pt-10 md:pb-32 md:pt-16" aria-labelledby="intro-kop" data-knoop>
    <LeafEdge kleur="#2a2416" seed={3} />
    <div class="container-woud">
      <div class="grid items-start gap-12 md:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] md:gap-14 lg:gap-24">
        <div class="pt-4 md:pt-24 lg:pt-52" data-groei>
          <h2 id="intro-kop" class="text-[clamp(1.85rem,2.9vw,2.5rem)] leading-[1.18] text-dauw-50">{intro.kop.split(/(?<=\.)\s+/).map((zin) => <span class="block">{zin}</span>)}</h2>
          <div class="mt-7 max-w-[58ch] space-y-5 text-dauw-200">
            {intro.tekst.map((p) => <p>{p}</p>)}
          </div>
        </div>
        <div class="mx-auto w-full max-w-[22rem] md:max-w-[26rem]" data-groei>
          <Venster src={introBeeld.src} alt={intro.beeld.alt} vorm={2} breedte={introBeeld.width} hoogte={introBeeld.height} class="aspect-[4/5] w-full" />
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Aanbod: vier rustige, gelijke kaarten; de knop naar het overzicht staat onderaan -->
  <section class="relative bg-[#33402a] pb-24 pt-24 md:pb-32 md:pt-32" aria-labelledby="ceremonies-kop" data-knoop>
    <LeafEdge kleur="#33402a" seed={31} />
    <div class="container-woud">
      <div data-groei>
        <h2 id="ceremonies-kop" class="text-[clamp(2.1rem,4.4vw,3.6rem)] text-dauw-50">{home.ceremonies.kop}</h2>
        <p class="mt-6 max-w-[56ch] text-dauw-200">{home.ceremonies.tekst}</p>
      </div>

      <ul class="mt-14 grid gap-5 md:grid-cols-2 md:gap-6">
        {ceremonies.map((d) => (
          <li class="aanbod group" data-groei>
            <Icoon naam={d.icoon as "truffel" | "paddenstoel" | "liaan" | "adem"} class="h-11 w-11 flex-none text-zonlicht-200" />
            <div>
              <h3 class="text-[1.4rem] leading-tight text-dauw-50 sm:text-[1.5rem] md:text-[1.65rem]">
                <a href={"/ceremonies/" + d.slug + "/"} class="aanbod-link no-underline">{d.titel}</a>
              </h3>
              <p class="mt-3 max-w-[46ch] text-dauw-200">{d.kort}</p>
              <p class="mt-5 inline-flex items-center gap-2 font-semibold text-zonlicht-200" aria-hidden="true">
                {home.ceremonies.kaartKnop}
                <span class="aanbod-pijl inline-block h-5 w-5"><Fragment set:html={pijl} /></span>
              </p>
            </div>
          </li>
        ))}
      </ul>

      <div class="mt-12 flex justify-center md:mt-14" data-groei>
        <a href="/ceremonies/" class="knop knop-rand">{home.ceremonies.knop}<Fragment set:html={pijl} /></a>
      </div>
    </div>
  </section>

  <!-- 4. Waarom ik dit doe: Nathalie's verhaal in het kort, met haar portret -->
  <section class="licht relative bg-mos-200 pb-24 pt-28 text-woud-950 md:pb-32 md:pt-36" aria-labelledby="waarom-kop" data-knoop="licht">
    <LeafEdge kleur="#e6d8b2" achter="#cdb77a" seed={47} omgekeerd />
    <div class="container-woud grid items-center gap-12 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] md:gap-14 lg:gap-24">
      <figure class="mx-auto w-full max-w-[18rem] md:max-w-[22rem]" data-groei>
        <Venster src={portret.src} alt={waarom.portret.alt} vorm={3} breedte={portret.width} hoogte={portret.height} class="aspect-[347/368] w-full" />
        <figcaption class="mt-5 text-center font-kop text-xl">{waarom.portret.naam}</figcaption>
      </figure>
      <div data-groei>
        <h2 id="waarom-kop" class="text-[clamp(2.1rem,4.4vw,3.6rem)]">{waarom.kop}</h2>
        <div class="mt-7 max-w-[58ch] space-y-5 text-jungle-800">
          {waarom.tekst.map((p) => <p>{p}</p>)}
        </div>
        <a href="/over-mij/" class="knop knop-rand mt-10">{waarom.knop}<Fragment set:html={pijl} /></a>
      </div>
    </div>
  </section>

  <!-- 5. Ervaringen -->
  <section class="licht relative bg-mos-100 pb-24 pt-24 md:pb-32 md:pt-28" aria-labelledby="ervaringen-kop" data-knoop="licht">
    <LeafEdge kleur="#f0e5c7" achter="#e0cf9e" seed={59} />
    <div class="container-woud" data-groei>
      <Ervaringen kop={home.ervaringen.kop} />
    </div>
  </section>

  <!-- 6. De open plek -->
  <section class="licht open-plek relative overflow-x-clip bg-dauw-50 pb-32 pt-28 text-woud-950 md:pb-40 md:pt-36" aria-labelledby="cta-kop" data-knoop="licht">
    <LeafEdge kleur="#f7efdc" achter="#f3e2b8" seed={71} omgekeerd />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="zonplek absolute left-1/2 top-[-10%] h-[120%] w-[min(1100px,140vw)] -translate-x-1/2"></div>
    </div>
    <div class="container-woud relative text-center" data-groei>
      <svg viewBox="0 0 120 120" class="mx-auto h-24 w-24 md:h-28 md:w-28" data-wortel-einde aria-hidden="true" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M60 104V58" stroke="#0f5c46" stroke-width="2" />
        <path d="M60 70c-4-16-18-24-34-20 1 15 15 25 34 20Z" fill="#1e9a6d" />
        <path d="M60 60c4-18 19-27 36-23-2 17-17 27-36 23Z" fill="#b7d65a" />
        <path d="M60 104c-6 4-14 6-24 6M60 104c0 5-1 9-3 12M60 104c6 4 14 5 22 4" stroke="#0f5c46" stroke-width="1.2" opacity=".6" />
        <path d="M34 104h52" stroke="#0f5c46" stroke-width="1.2" opacity=".35" />
      </svg>
      <h2 id="cta-kop" class="mx-auto mt-6 text-[clamp(2.6rem,6vw,5rem)]">{cta.kop}</h2>
      <p class="mx-auto mt-6 max-w-[52ch] text-[1.125rem] text-jungle-800 md:text-[1.2rem]">{cta.tekst}</p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/contact/" class="knop knop-zon">{cta.knop}<Fragment set:html={pijl} /></a>
        <a href="/intake/" class="knop knop-rand">{cta.intakeKnop}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .aanbod {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    align-items: start;
    padding: 1.75rem 1.5rem;
    border: 1px solid rgb(232 194 122 / 0.16);
    border-radius: 1.25rem;
    background: rgb(26 18 12 / 0.18);
    transition: background-color 0.6s var(--ease-adem), border-color 0.6s var(--ease-adem);
  }
  .aanbod > div { min-width: 0; }
  .aanbod h3 { hyphens: auto; overflow-wrap: break-word; }
  @media (max-width: 479px) { .aanbod { grid-template-columns: 1fr; gap: 1rem; } }
  @media (min-width: 768px) { .aanbod { padding: 2.25rem 2rem; gap: 1.5rem; } }
  .aanbod:hover { background: rgb(26 18 12 / 0.3); border-color: rgb(232 194 122 / 0.32); }
  .aanbod-link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .aanbod-link:focus-visible { outline: none; }
  .aanbod:has(.aanbod-link:focus-visible) { outline: 2px solid var(--zonlicht-400); outline-offset: 4px; }
  .aanbod-pijl { transition: transform 0.6s var(--ease-adem); }
  .aanbod:hover .aanbod-pijl { transform: translateX(4px); }
  .zonplek {
    background:
      radial-gradient(45% 38% at 50% 30%, rgb(240 176 63 / 0.28), transparent 70%),
      radial-gradient(70% 55% at 50% 35%, rgb(248 214 143 / 0.22), transparent 75%),
      conic-gradient(from 160deg at 50% 0%, transparent 0deg, rgb(248 214 143 / 0.16) 8deg, transparent 16deg, transparent 22deg, rgb(248 214 143 / 0.12) 28deg, transparent 36deg, transparent 44deg, rgb(248 214 143 / 0.14) 50deg, transparent 58deg);
    mask: linear-gradient(180deg, #000 0%, #000 50%, transparent 95%);
  }
</style>
