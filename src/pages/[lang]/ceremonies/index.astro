---
import CeremoniesOverview from '../../../components/CeremoniesOverview.astro';
import { languages, defaultLang, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return languages
    .filter((l) => l !== defaultLang)
    .map((lang) => ({
      params: { lang },
    }));
}

const { lang } = Astro.params as { lang: Lang };
---
<CeremoniesOverview lang={lang} />
