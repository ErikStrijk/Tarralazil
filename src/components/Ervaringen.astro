---
// Ervaringen van deelnemers — lichte, snel scanbare weergave zonder nep-AI-portretten
import Icoon from './Icoon.astro';
import { getContent, getLangFromUrl, localePath, type Lang } from '../lib/i18n';

export interface ErvaringItem {
  id?: string;
  naam: string;
  ceremonie: string;
  categorie?: string;
  ceremonieSlug?: string;
  tekst: string;
  thema?: string;
  kernzin?: string;
  verhaal?: string;
  inzicht?: string;
}

interface Props {
  kop?: string;
  lang?: Lang;
  limiet?: number;
}

const { kop: propKop, lang = getLangFromUrl(Astro.url.pathname), limiet = 3 } = Astro.props;
const { ervaringen: rawErvaringen, home } = getContent(lang);
const alleErvaringen = rawErvaringen as ErvaringItem[];
const getoondeErvaringen = limiet > 0 ? alleErvaringen.slice(0, limiet) : alleErvaringen;

const kop = propKop || home.ervaringen.kop || 'Wat anderen mochten ervaren';
const subtitel = home.ervaringen.subtitel;
const alleVerhalenKnop = (home.ervaringen as any).alleVerhalenKnop || 'Lees alle verhalen';

const verhalenUrl = localePath('/verhalen/', lang);

const pijl = '<svg viewBox="0 0 48 48" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 24h30M28 14c3 5 7 8 11 10-4 2-8 5-11 10"/></svg>';
---

<div class="ervaringen-sectie">
  <header class="maat-kop">
    <h2 id="ervaringen-kop" class="sectie-kop text-dauw-50">
      {kop}
    </h2>
    {subtitel && (
      <p class="maat-tekst mt-4 text-[1.0625rem] leading-relaxed text-dauw-200">
        {subtitel}
      </p>
    )}
  </header>

  <ul class="raster mt-12 gap-y-10 md:mt-14">
    {getoondeErvaringen.map((e) => {
      const verhaalAnker = e.id ? `${verhalenUrl}#verhaal-${e.id}` : verhalenUrl;
      const ceremonieHref = e.ceremonieSlug ? `${localePath('/ceremonies/', lang)}#${e.ceremonieSlug}` : localePath('/ceremonies/', lang);

      return (
        <li class="flex md:col-span-4">
          <article class="flex h-full w-full flex-col justify-between border-t border-dauw-50/15 pt-7">
            <blockquote class="text-[1.02rem] leading-[1.75] text-dauw-200">
              <p>“{e.tekst}”</p>
            </blockquote>

            <footer class="mt-5 flex items-center gap-3">
              <Icoon naam="kiem" class="h-5 w-5 flex-none text-zonlicht-200" />
              <div class="min-w-0 flex-1">
                <a href={verhaalAnker} class="block font-kop text-base leading-snug text-dauw-50 no-underline hover:text-zonlicht-200">
                  {e.naam}
                </a>
                <a href={ceremonieHref} class="mt-0.5 inline-block text-xs text-dauw-200/75 no-underline hover:text-dauw-50 hover:underline">
                  {e.ceremonie}
                </a>
              </div>
            </footer>
          </article>
        </li>
      );
    })}
  </ul>

  <div class="mt-11 flex">
    <a href={verhalenUrl} class="knop knop-rand">
      {alleVerhalenKnop}
      <Fragment set:html={pijl} />
    </a>
  </div>
</div>
