---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import LeafEdge from './LeafEdge.astro';
import Icoon from './Icoon.astro';
import Venster from './Venster.astro';
import { getContent, localePath, type Lang } from '../lib/i18n';
import { ceremonieBeelden, overzichtBeeld } from '../lib/ceremonieBeelden';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { ceremonies } = getContent(lang);

const pijl = '<svg viewBox="0 0 48 48" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 24h30M28 14c3 5 7 8 11 10-4 2-8 5-11 10"/></svg>';
const blad = '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14Z"/><path d="M5 19 13 11"/></svg>';

const T = {
  nl: {
    seoTitel: 'Ceremonies & Ademwerk in Sappemeer | Tarra Lanzilli',
    seoBeschrijving: 'Overzicht van truffel-, paddenstoelen- en Mother Nature-ceremonies en ademwerk in Sappemeer. Persoonlijke en veilige begeleiding door Nathalie.',
    label: 'Ceremonies & Ademwerk',
    kop: 'Vier wegen naar binnen, elk met een eigen karakter',
    sub: 'Of je nu kiest voor de aardse zachtheid van truffels, de diepgang van paddenstoelen of Mother Nature, of de directe kracht van je eigen adem: elke sessie vindt plaats in alle rust en met persoonlijke begeleiding.',
    agendaKop: 'Twijfel je wat bij je past?',
    agendaTekst: 'Je hoeft vooraf nog niet precies te weten welke vorm het beste aansluit. In een vrijblijvend voorgesprek luister ik naar waar je staat en kijken we samen wat op dit moment klopt voor jou.',
    contactKnop: 'Plan een kennismaking',
    intakeKnop: 'Start je intake',
  },
  en: {
    seoTitel: 'Ceremonies & Breathwork in Sappemeer | Tarra Lanzilli',
    seoBeschrijving: 'Overview of truffle, mushroom and Mother Nature ceremonies and breathwork in Sappemeer. Personal and safe guidance by Nathalie.',
    label: 'Ceremonies & Breathwork',
    kop: 'Four paths inward, each with its own character',
    sub: 'Whether you choose the grounded gentleness of truffles, the depth of mushrooms or Mother Nature, or the direct power of your own breath: every session takes place in calm and with personal guidance.',
    agendaKop: 'Not sure what suits you best?',
    agendaTekst: 'You do not need to know beforehand which form fits best. In a no-obligation conversation I listen to where you are and we explore together what feels right for you at this moment.',
    contactKnop: 'Schedule an introduction',
    intakeKnop: 'Start your intake',
  },
  es: {
    seoTitel: 'Ceremonias y Respiración en Sappemeer | Tarra Lanzilli',
    seoBeschrijving: 'Ceremonias de trufas, setas, Mother Nature y respiración en Sappemeer. Acompañamiento personal y seguro con Nathalie.',
    label: 'Ceremonias y Respiración',
    kop: 'Cuatro caminos hacia el interior, cada uno con su propio carácter',
    sub: 'Ya elijas la suavidad terrenal de las trufas, la profundidad de las setas o de Mother Nature, o la fuerza directa de tu propia respiración: cada sesión se vive con calma y acompañamiento personal.',
    agendaKop: '¿Dudas sobre qué va mejor contigo?',
    agendaTekst: 'No necesitas saber de antemano qué forma se adapta mejor a ti. En una charla sin compromiso escucho en qué momento estás y vemos juntos qué es lo más adecuado para ti.',
    contactKnop: 'Agenda una conversación',
    intakeKnop: 'Empieza tu admisión',
  },
}[lang];
---
<Base titel={T.seoTitel} beschrijving={T.seoBeschrijving} lang={lang}>
  <!-- 1. Rustige Hero -->
  <PageHero
    id="hero-kop"
    eyebrow={T.label}
    kop={T.kop}
    tekst={T.sub}
    beeld={overzichtBeeld}
    beeldPositie="object-center"
  />

  <!-- 2. De vier vormen: kort en rustig op één pagina -->
  <!-- Zelfde ritme als Verhalen, Contact en Intake: donkere hero → lichte mos-sectie met lichte kaarten → crème CTA -->
  <section id="overzicht" class="licht relative bg-mos-100 pb-24 pt-20 text-woud-950 md:pb-28 md:pt-24" aria-label={T.label}>
    <LeafEdge kleur="#f2e4c2" seed={33} omgekeerd />
    <div class="container-woud">
      <!-- Twee kolommen op het raster; de rechterkolom zakt iets voor een organisch ritme -->
      <ul class="raster gap-y-16 md:gap-y-20">
        {ceremonies.map((c: any, i: number) => (
          <li id={c.slug} class:list={['scroll-mt-28 md:col-span-6', { 'md:mt-24': i % 2 === 1 }]} data-groei>
            <article>
              {ceremonieBeelden[c.slug] && (
                <Venster vorm={((i % 4) + 1) as 1 | 2 | 3 | 4} class="aspect-[4/3] w-full">
                  <Image
                    src={ceremonieBeelden[c.slug]}
                    alt=""
                    widths={[480, 800, 1100]}
                    sizes="(min-width: 768px) 560px, 100vw"
                  />
                </Venster>
              )}

              <div class="mt-7 flex items-center gap-3 text-jungle-800" aria-hidden="true">
                <span class="font-kop text-[1.05rem] leading-none">{String(i + 1).padStart(2, '0')}</span>
                <span class="h-px w-10 bg-jungle-800/30"></span>
                <Icoon naam={c.icoon} class="h-6 w-6 flex-none" />
              </div>

              <h2 class="mt-3 text-[1.55rem] leading-tight text-woud-950 md:text-[1.75rem]">{c.titel}</h2>
              <div class="maat-tekst mt-3.5 space-y-3 text-[1.02rem] leading-[1.75] text-woud-950/80">
                {(Array.isArray(c.toelichting) ? c.toelichting : [c.toelichting || c.kort]).map((alinea: string) => <p>{alinea}</p>)}
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. Afsluiting: Samen voelen wat past -->
  <section id="agenda" class="licht relative bg-dauw-50 pb-28 pt-20 text-center text-woud-950 md:pb-36 md:pt-28" aria-labelledby="agenda-kop">
    <LeafEdge kleur="#faf3e4" seed={67} />
    <div class="container-woud">
      <div class="afsluiting" data-groei>
        <Icoon naam="kiem" class="mx-auto h-10 w-10 text-jungle-800" />
        <h2 id="agenda-kop" class="sectie-kop mt-3 text-balance text-woud-950">{T.agendaKop}</h2>
        <p class="afsluiting-tekst mt-4">{T.agendaTekst}</p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a href={localePath('/contact/', lang)} class="knop knop-zon">{T.contactKnop}<Fragment set:html={pijl} /></a>
          <a href={localePath('/intake/', lang)} class="knop knop-rand"><Fragment set:html={blad} />{T.intakeKnop}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
