---
import { languages, langLabels, langNames, switchLangUrl, type Lang } from '../lib/i18n';

interface Props {
  currentLang: Lang;
  class?: string;
  mobile?: boolean;
}

const { currentLang, class: className = '', mobile = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

{
  mobile ? (
    <div class:list={['flex items-center gap-3', className]} role="group" aria-label="Taalkeuze">
      {languages.map((l) => {
        const isCurrent = l === currentLang;
        const targetUrl = switchLangUrl(currentPath, l);
        return (
          <a
            href={targetUrl}
            class:list={[
              'px-2 py-1 text-sm no-underline transition-colors',
              isCurrent
                ? 'font-semibold text-zonlicht-200 underline decoration-zonlicht-400 underline-offset-4'
                : 'text-dauw-200/75 hover:text-dauw-50'
            ]}
            aria-current={isCurrent ? 'true' : undefined}
            title={langNames[l]}
          >
            {langLabels[l]}
          </a>
        );
      })}
    </div>
  ) : (
    <div class:list={['inline-flex items-center gap-1 text-xs', className]} role="group" aria-label="Taalkeuze">
      {languages.map((l, idx) => {
        const isCurrent = l === currentLang;
        const targetUrl = switchLangUrl(currentPath, l);
        return (
          <>
            {idx > 0 && <span class="text-dauw-200/30" aria-hidden="true">/</span>}
            <a
              href={targetUrl}
              class:list={[
                'px-1.5 py-1 no-underline transition-colors',
                isCurrent
                  ? 'font-semibold text-zonlicht-200'
                  : 'text-dauw-200/70 hover:text-dauw-50'
              ]}
              aria-current={isCurrent ? 'true' : undefined}
              title={langNames[l]}
            >
              {langLabels[l]}
            </a>
          </>
        );
      })}
    </div>
  )
}
