    </>
  )}
  {naam === 'liaan' && (
    <>
      <path d="M18 44c-4-8 6-12 2-20s6-12 4-20" />
      <path d="M30 44c3-7-5-11-1-18s-4-11 0-18" opacity=".6" />
      <path d="M20 32c-4-1-7 0-9 3 3 2 7 1 9-3ZM22 20c4-2 7-1 9 1-3 3-7 2-9-1ZM23 10c-3-2-6-2-8 0 2 2.5 5.5 2.5 8 0Z" />
    </>
  )}
  {naam === 'adem' && (
    <>
      <path d="M6 18c6 0 8-4 14-4s8 4 14 4c3 0 5-1 8-3" />
      <path d="M6 26c6 0 8-4 14-4s8 4 14 4c3 0 5-1 8-3" opacity=".75" />
      <path d="M6 34c6 0 8-4 14-4s8 4 14 4c3 0 5-1 8-3" opacity=".5" />
    </>
  )}
  {naam === 'pijl' &&<path d="M8 24h30M28 14c3 5 7 8 11 10-4 2-8 5-11 10" />}
</svg>
