---
// Eigen botanische iconen, één lijndikte, als kleine natuurkundige plaatjes.
interface Props { naam: 'varen' | 'wortel' | 'mycelium' | 'kiem' | 'monstera' | 'paddenstoel' | 'truffel' | 'liaan' | 'adem' | 'pijl'; class?: string }
const { naam, class: cls = 'h-12 w-12' } = Astro.props;
---
<svg viewBox="0 0 48 48" class={cls} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  {naam === 'varen' && (
    <>
      <path d="M14 44c4-10 10-22 20-36" />
      <path d="M17 37c-4-1-7 0-9 2M17 37c1-4 0-7-2-9M21 30c-4-1-7-.5-9 1.5M21 30c1-4 .5-7-1.5-9M25 23.5c-3.5-1-6-.5-8 1M25 23.5c1-3.5.5-6-1-8M29 17c-3-1-5-.5-6.5 1M29 17c1-3 .5-5-.5-6.5M32 11.5c-2-.5-3.5 0-4.5.8M32 11.5c.8-2 .6-3.5-.2-4.6" />
    </>
  )}
  {naam === 'wortel' && (
    <>
      <path d="M24 4v12" />
      <path d="M20 9c0-3 2-5 4-5s4 2 4 5" opacity=".5" />
      <path d="M24 16c0 6-3 10-8 14s-6 8-6 14M24 16c1 7 4 11 9 15 3 2.5 4 6 4 10M24 16c0 8 .5 15-1 24" />
      <path d="M17 29c-3 0-5 1-7 3M31 30c2.5-1 5-1 7 .5M23.5 33c-2 1-3 3-3.5 5" opacity=".7" />
    </>
  )}
  {naam === 'mycelium' && (
    <>
      <path d="M8 30c6-2 10-8 16-8s9 5 16 4M24 22v-8M24 22c-2 6-7 10-12 14M24 22c3 5 7 9 13 12M16 25c-3-3-6-4-9-3M33 25c2-3 5-4 8-3" />
      <circle cx="24" cy="12" r="2.4" fill="var(--limoen-300)" stroke="none" />
      <circle cx="12" cy="36" r="1.8" fill="currentColor" stroke="none" />
      <circle cx="37" cy="34" r="1.8" fill="currentColor" stroke="none" />
      <circle cx="7" cy="22" r="1.5" fill="currentColor" stroke="none" />
      <circle cx="41" cy="22" r="1.5" fill="currentColor" stroke="none" />
    </>
  )}
  {naam === 'kiem' && (
    <>
      <path d="M24 42V22" />
      <path d="M24 26c-2-7-8-10-15-9 0 7 6 11 15 9Z" />
      <path d="M24 22c2-7 8-11 15-10-.5 7-6.5 11-15 10Z" />
      <path d="M12 42h24" opacity=".5" />
      <path d="M18 42c1 2 2 3 4 3.5M30 42c-1 2-2 3-4 3.5" opacity=".5" />
    </>
  )}
  {naam === 'monstera' && (
    <>
      <path d="M24 44V30" />
      <path d="M24 30c-9 0-17-6-17-15C7 9 13 4 24 4s17 5 17 11c0 9-8 15-17 15Z" />
      <path d="M24 30V6M24 12l-7-3M24 17l-10-2M24 22l-9 1M24 12l7-3M24 17l10-2M24 22l9 1" opacity=".55" />
    </>
  )}
  {naam === 'paddenstoel' && (
    <>
      <path d="M7 22c0-9 8-15 17-15s17 6 17 15c-5 2-11 3-17 3S12 24 7 22Z" />
      <path d="M19 25c-.5 6-1 12-2 17h14c-1-5-1.5-11-2-17" />
      <circle cx="17" cy="15" r="1.6" fill="currentColor" stroke="none" />
      <circle cx="27" cy="12" r="1.3" fill="currentColor" stroke="none" />
      <circle cx="32" cy="18" r="1.1" fill="currentColor" stroke="none" />
    </>
  )}
  {naam === 'truffel' && (
    <>
      <path d="M6 18h36" opacity=".4" stroke-dasharray="1.5 3.5" />
      <path d="M15 37c-4-.5-6-4.5-4.5-8 1.2-3.2 4.8-4.4 7.6-3.2 3.2-2.3 8-1.2 9 2.5 3.3.8 4.8 4.4 3.2 7.2-1.6 3.2-5.4 4-8 2.5-2.4 1.4-5.4.8-7.3-1Z" />
      <path d="M33 41c-2.6 0-4.2-2.6-3.2-4.9.7-2.2 3.2-2.9 5.1-1.9 2.2-.9 5 .3 5 2.9 1.6 1.3 1.3 3.8-.6 4.8-1.6 1-3.8.3-4.8-.6-.6 0-1 0-1.5-.3Z" opacity=".75" />
