---
import Logo from './Logo.astro';
import LeafEdge from './LeafEdge.astro';
import LanguagePicker from './LanguagePicker.astro';
import { getContent, getLangFromUrl, localePath, type Lang } from '../lib/i18n';
import { roots } from '../lib/botany';

interface Props {
  lang?: Lang;
}

const { lang = getLangFromUrl(Astro.url.pathname) } = Astro.props;
const { site, ui } = getContent(lang);

const pad = Astro.url.pathname;
const homeHref = localePath('/', lang);
const isActief = (href: string) =>
  href === homeHref ? pad === homeHref : pad.startsWith(href);

const jaar = new Date().getFullYear();
const draden = [roots(77, 340, -10, 220, 2), roots(91, 1160, -10, 200, 2)];

const whatsappLink = `https://wa.me/${site.contact.whatsapp}`;
const instagramLink =
  site.contact.instagramUrl || `https://www.instagram.com/${site.contact.instagram || 'tarralanzilli'}/`;
const toonKvk = Boolean(site.contact.kvk && !site.contact.kvk.startsWith('['));
---

<footer class="footer-woud relative bg-woud-950 text-dauw-50">
  <LeafEdge kleur="#1a110a" seed={83} />

  <!-- Subtiele worteldraden op de achtergrond -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <svg
      viewBox="0 0 1440 320"
      preserveAspectRatio="xMidYMin slice"
      class="absolute inset-x-0 top-0 h-[320px] w-full text-zonlicht-200/[0.08]"
      fill="none"
      stroke="currentColor"
      stroke-width="1"
      stroke-linecap="round"
    >
      {draden.map((d) => <path d={d} />)}
    </svg>
  </div>

  <div class="container-woud relative pb-12 pt-24 lg:pb-14 lg:pt-28">
    <div class="raster gap-y-12">
      <!-- Kolom 1: Merk & korte tekst -->
      <div class="flex flex-col items-start sm:col-span-12 lg:col-span-5">
        <a
          href={homeHref}
          class="text-dauw-50 no-underline transition-opacity hover:opacity-90"
          aria-label={`${site.naam}, ${ui.naarHomepage}`}
        >
          <Logo groot />
        </a>

        <p class="mt-4 max-w-[36ch] text-[0.98rem] leading-[1.72] text-dauw-200/90">
          {site.footerTekst}
        </p>

        <p class="mt-3 text-sm text-dauw-200/65">
          {site.eigenaar} &middot; {site.contact.plaats}
        </p>
      </div>

      <!-- Kolom 2: Navigatie -->
      <nav aria-labelledby="footer-links" class="sm:col-span-6 lg:col-span-3">
        <h2 id="footer-links" class="footer-kop">{ui.links}</h2>
        <ul class="mt-4 space-y-2.5 text-[0.98rem]">
          {site.menu.map((m) => {
            const actief = isActief(m.href);
            return (
              <li>
                <a
                  href={m.href}
                  class:list={['footer-link', { 'is-actief': actief }]}
                  aria-current={actief ? 'page' : undefined}
                >
                  {m.label}
                </a>
              </li>
            );
          })}
          <li>
            <a
              href={localePath('/intake/', lang)}
              class:list={['footer-link', { 'is-actief': isActief(localePath('/intake/', lang)) }]}
              aria-current={isActief(localePath('/intake/', lang)) ? 'page' : undefined}
            >
              {ui.intake}
            </a>
          </li>
        </ul>
      </nav>

      <!-- Kolom 3: Contact & Socials -->
      <div class="sm:col-span-6 lg:col-span-4">
        <h2 class="footer-kop">{ui.contact}</h2>
        <address class="mt-4 space-y-3 text-[0.98rem] not-italic text-dauw-200">
          <p class="flex items-center gap-3">
            <span class="footer-icoon" aria-hidden="true">
              <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 17.5s5.5-5.2 5.5-9.5a5.5 5.5 0 1 0-11 0c0 4.3 5.5 9.5 5.5 9.5Z" />
                <circle cx="10" cy="8" r="2" />
              </svg>
            </span>
            <span>{site.contact.plaats}</span>
          </p>

          <p class="flex items-center gap-3">
            <span class="footer-icoon" aria-hidden="true">
              <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2.5" y="4.5" width="15" height="11" rx="2" />
                <path d="m3.5 6 6.5 4.5L16.5 6" />
              </svg>
            </span>
            <a href={`mailto:${site.contact.email}`} class="footer-link break-all">
              {site.contact.email}
            </a>
          </p>

          <p class="flex items-center gap-3">
            <span class="footer-icoon" aria-hidden="true">
              <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3.5 4.5h3l1.5 3.5-1.75 1.25a10.5 10.5 0 0 0 4.5 4.5L12 12l3.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5A12.5 12.5 0 0 1 2 6a1.5 1.5 0 0 1 1.5-1.5Z" />
              </svg>
            </span>
            <a href={`tel:${site.contact.telefoonLink}`} class="footer-link">
              {site.contact.telefoon}
            </a>
          </p>

          {toonKvk && (
            <p class="pl-8 text-xs text-dauw-200/65">KvK {site.contact.kvk}</p>
          )}

          <!-- Social pills in het warme aardepalet -->
          <div class="flex flex-wrap items-center gap-2.5 pt-2">
            <a
              href={whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-social"
              aria-label={ui.whatsappSr}
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current text-zonlicht-200" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
              </svg>
              <span>WhatsApp</span>
            </a>

            <a
              href={instagramLink}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-social"
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current text-zonlicht-200" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
              </svg>
              <span>Instagram</span>
            </a>

            <a href={`mailto:${site.contact.email}`} class="footer-social">
              <svg viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current text-zonlicht-200" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2.5" />
                <path d="m4 7 8 5.5L20 7" />
              </svg>
              <span>{ui.emailTitel}</span>
            </a>
          </div>
        </address>
      </div>
    </div>

    <!-- Onderbalk: copyright, taalkeuze & juridische links (met ruimte rechts voor zwevende SocialKnop) -->
    <div class="mt-12 flex flex-col gap-4 border-t border-dauw-50/12 pt-7 pr-14 text-sm text-dauw-200/80 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:pr-16">
      <p>&copy; {jaar} {site.naam}. {ui.rechten}</p>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <LanguagePicker currentLang={lang} />
        <span class="hidden text-dauw-200/25 sm:inline" aria-hidden="true">&middot;</span>
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {site.juridisch.map((j) => (
            <li>
              <a href={j.href} class="footer-link text-sm">
                {j.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-woud {
    background:
      radial-gradient(ellipse 70% 50% at 15% 0%, rgba(224, 139, 26, 0.06), transparent 70%),
      var(--woud-950);
  }
  .footer-kop {
    font-size: 1.15rem;
    color: var(--zonlicht-200);
    letter-spacing: 0.01em;
  }
  .footer-link {
    color: var(--dauw-200);
    text-decoration: none;
    transition: color 0.3s var(--ease-adem);
  }
  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--zonlicht-200);
  }
  .footer-link.is-actief {
    color: var(--dauw-50);
    font-weight: 500;
  }
  .footer-icoon {
    display: inline-grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 999px;
    background: rgba(240, 195, 106, 0.09);
    color: var(--zonlicht-200);
    flex-shrink: 0;
  }
  .footer-social {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--dauw-50);
    text-decoration: none;
    background: rgba(250, 243, 228, 0.05);
    border: 1px solid rgba(250, 243, 228, 0.12);
    transition: background-color 0.3s var(--ease-adem), border-color 0.3s var(--ease-adem), color 0.3s var(--ease-adem);
  }
  .footer-social:hover,
  .footer-social:focus-visible {
    background: rgba(240, 195, 106, 0.14);
    border-color: rgba(240, 195, 106, 0.4);
    color: var(--zonlicht-200);
  }
</style>
