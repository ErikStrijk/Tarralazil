---
// Hero met foto (photos/hero.webp, aangeleverd door de eigenaar).
// Rustig gehouden: de foto staat gedempt aan de rechterkant, de tekst heeft links een egale, warme ondergrond.
import { Picture } from 'astro:assets';
import heroFoto from '../assets/hero.webp';
---
<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="hero-foto absolute -inset-y-[4%] inset-x-0 lg:left-auto lg:w-[56%]" data-parallax="0.06">
    <Picture
      src={heroFoto}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1920]}
      sizes="(min-width: 1024px) 56vw, 100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover object-[68%_50%] md:object-[62%_50%]"
    />
  </div>

  <!-- warme sluier: dempt het contrast van de foto, zodat het oog bij de tekst kan rusten -->
  <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(26_18_12/.7)_0%,rgb(26_18_12/.88)_45%,rgb(26_18_12/.93)_100%)] lg:bg-[linear-gradient(90deg,rgb(26_18_12/.4),rgb(26_18_12/.3))]"></div>
  <div class="absolute inset-x-0 bottom-0 h-[30%] bg-[linear-gradient(180deg,transparent,rgb(26_18_12/.9))]"></div>
  <div class="absolute inset-x-0 top-0 h-40 bg-[linear-gradient(180deg,rgb(26_18_12/.75),transparent)]"></div>
</div>

<style>
  .hero-foto :global(img) {
    filter: saturate(0.85) brightness(0.97);
  }
  @media (min-width: 1024px) {
    .hero-foto {
      -webkit-mask: linear-gradient(90deg, transparent 8%, #000 62%);
      mask: linear-gradient(90deg, transparent 8%, #000 62%);
    }
  }
</style>
