---
// Hero met foto: de foto staat gedempt aan de rechterkant, de tekst heeft links een egale, warme ondergrond.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import heroFoto from '../assets/hero.webp';

interface Props {
  beeld?: ImageMetadata;
  positie?: string;
  zacht?: boolean;
  /** Homepage: foto groter, helderder en minder gedempt */
  sterk?: boolean;
}

const {
  beeld = heroFoto,
  positie = 'object-[center_35%]',
  zacht = false,
  sterk = false,
} = Astro.props;
---
<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <div
    class:list={[
      'hero-foto absolute -inset-y-[4%] inset-x-0 lg:left-auto',
      sterk ? 'hero-foto-sterk lg:w-[70%]' : 'lg:w-[58%]',
      { 'hero-foto-zacht': zacht },
    ]}
    data-parallax="0.05"
  >
    <Picture
      src={beeld}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1920]}
      sizes={sterk ? '(min-width: 1024px) 70vw, 100vw' : '(min-width: 1024px) 58vw, 100vw'}
      alt=""
      loading="eager"
      fetchpriority="high"
      class={`h-full w-full object-cover ${positie}`}
    />
  </div>

  <!-- warme sluier: dempt het felle licht, zodat tekst en navigatie rust krijgen -->
  <div
    class:list={[
      'absolute inset-0',
      sterk
        ? 'bg-[linear-gradient(180deg,rgb(32_20_8/.62)_0%,rgb(46_30_16/.55)_45%,rgb(46_30_16/.82)_100%)] lg:bg-[linear-gradient(90deg,rgb(46_30_16/.94)_0%,rgb(46_30_16/.55)_38%,rgb(32_20_8/.12)_100%)]'
        : zacht
        ? 'bg-[linear-gradient(180deg,rgb(32_20_8/.86)_0%,rgb(46_30_16/.84)_50%,rgb(46_30_16/.92)_100%)] lg:bg-[linear-gradient(90deg,rgb(46_30_16/.97)_0%,rgb(46_30_16/.82)_50%,rgb(32_20_8/.68)_100%)]'
        : 'bg-[linear-gradient(180deg,rgb(32_20_8/.78)_0%,rgb(46_30_16/.76)_50%,rgb(46_30_16/.88)_100%)] lg:bg-[linear-gradient(90deg,rgb(46_30_16/.95)_0%,rgb(46_30_16/.65)_48%,rgb(32_20_8/.38)_100%)]',
    ]}
  ></div>
  <div class="absolute inset-x-0 bottom-0 h-[35%] bg-[linear-gradient(180deg,transparent,rgb(46_30_16/.85)_70%,rgb(46_30_16)_100%)]"></div>
  <div class="absolute inset-x-0 top-0 h-36 bg-[linear-gradient(180deg,rgb(26_17_10/.72)_0%,rgb(26_17_10/.35)_55%,transparent_100%)]"></div>
</div>

<style>
  .hero-foto :global(img) {
    filter: saturate(0.85) brightness(0.84) contrast(0.95);
  }
  .hero-foto-sterk :global(img) {
    filter: saturate(0.95) brightness(0.95) contrast(1);
  }
  .hero-foto-zacht :global(img) {
    filter: saturate(0.75) brightness(0.68) contrast(0.92);
  }
  @media (min-width: 1024px) {
    .hero-foto {
      -webkit-mask: linear-gradient(90deg, transparent 12%, rgb(0 0 0 / 0.55) 48%, #000 78%);
      mask: linear-gradient(90deg, transparent 12%, rgb(0 0 0 / 0.55) 48%, #000 78%);
    }
    .hero-foto-sterk {
      -webkit-mask: linear-gradient(90deg, transparent 4%, rgb(0 0 0 / 0.75) 30%, #000 52%);
      mask: linear-gradient(90deg, transparent 4%, rgb(0 0 0 / 0.75) 30%, #000 52%);
    }
  }
</style>
