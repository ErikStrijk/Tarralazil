---
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import LeafEdge from './LeafEdge.astro';
import Venster from './Venster.astro';
import Icoon from './Icoon.astro';
import Ervaringen from './Ervaringen.astro';
import { getContent, localePath, type Lang } from '../lib/i18n';
import introBeeld from '../assets/intro-wortels-beuk.webp';
import portret from '../assets/tarra-portret.webp';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { home, ceremonies, overMij } = getContent(lang);
const { hero, intro, waarom, cta } = home;

const pijl = '<svg viewBox="0 0 48 48" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 24h30M28 14c3 5 7 8 11 10-4 2-8 5-11 10"/></svg>';

const heroEyebrow = {
  nl: 'Ceremonies & Ademwerk · Sappemeer',
  en: 'Ceremonies & Breathwork · Sappemeer',
  es: 'Ceremonias y Respiración · Sappemeer',
}[lang];

const [introEersteZin, ...introRestZinnen] = intro.kop.split(/(?<=[.?!])\s+/);
const introTweedeZin = introRestZinnen.join(' ');
---
<Base titel={home.seo.titel} beschrijving={home.seo.beschrijving} lang={lang}>
  <!-- 1. Hero: sfeervol welkom -->
  <PageHero id="hero-kop" eyebrow={heroEyebrow} kop={hero.kop} tekst={hero.tekst} groot>
    <Fragment slot="acties">
      <a href={localePath('/contact/', lang)} class="knop knop-zon">{hero.knop}<Fragment set:html={pijl} /></a>
      <a href={localePath('/ceremonies/', lang)} class="tekstlink text-[1.05rem]">{hero.link}</a>
    </Fragment>
  </PageHero>

  <!-- 2. Herkenning: direct zichtbaar onder de hero (geen fade-in vertraging op het startscherm) -->
  <section class="licht relative bg-mos-100 pb-18 pt-12 text-woud-950 md:pb-24 md:pt-16" aria-labelledby="intro-kop">
    <LeafEdge kleur="#f2e4c2" seed={3} omgekeerd />
    <div class="container-woud">
      <div class="raster items-start gap-y-12">
        <div class="md:col-span-7">
          <h2 id="intro-kop" class="sectie-kop text-[clamp(1.85rem,3.4vw,2.8rem)] text-woud-950">
            <span class="block">{introEersteZin}</span>
            {introTweedeZin && <span class="mt-1 block text-jungle-800">{introTweedeZin}</span>}
          </h2>
          <div class="maat-tekst mt-4 space-y-3.5 text-[1rem] leading-[1.75] text-woud-950/85 md:text-[1.0625rem]">
            {intro.tekst.map((p: string) => <p>{p}</p>)}
          </div>

          {intro.punten && (
            <ul class="kaart-licht mt-9 divide-y divide-jungle-800/10 px-5 md:px-7">
              {intro.punten.map((punt: { titel: string; tekst: string }) => (
                <li class="flex items-start gap-4 py-5">
                  <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-mos-200/75 text-jungle-800" aria-hidden="true">
                    <Icoon naam="kiem" class="h-5 w-5" />
                  </span>
                  <div class="min-w-0 pt-0.5">
                    <h3 class="font-kop text-[1.05rem] leading-snug text-woud-950 md:text-[1.12rem]">{punt.titel}</h3>
                    <p class="mt-1.5 text-[0.95rem] leading-[1.6] text-woud-950/75">{punt.tekst}</p>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="mx-auto w-full max-w-[18.5rem] md:col-span-5 md:sticky md:top-28 md:mt-4 md:mr-0 md:max-w-[21rem]">
          <Venster src={introBeeld.src} alt={intro.beeld.alt} vorm={2} laden="eager" breedte={introBeeld.width} hoogte={introBeeld.height} class="aspect-[4/5] w-full" />
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Wie je begeleidt: eerst kennismaken met Nathalie voor vertrouwen -->
  <section class="relative bg-woud-800 pb-24 pt-20 text-dauw-50 md:pb-28 md:pt-24" aria-labelledby="waarom-kop">
    <LeafEdge kleur="#2e1e10" seed={19} />
    <div class="container-woud">
      <div class="raster items-center gap-y-12">
        <figure class="mx-auto w-full max-w-[17rem] md:col-span-5 md:ml-0 md:max-w-[20rem]" data-groei>
          <Venster src={portret.src} alt={waarom.portret.alt} vorm={3} breedte={portret.width} hoogte={portret.height} class="aspect-[347/368] w-full" />
          {overMij.hero.badges?.[0] && (
            <figcaption class="mt-4 text-center text-sm text-dauw-200/70 md:text-left">
              {overMij.hero.badges[0]} · {overMij.hero.badges[1]}
            </figcaption>
          )}
        </figure>

        <div class="md:col-span-7" data-groei>
          <h2 id="waarom-kop" class="sectie-kop text-dauw-50">{waarom.kop}</h2>
          <div class="maat-tekst mt-5 space-y-4 text-[1.0625rem] leading-[1.78] text-dauw-200 md:text-[1.125rem]">
            {waarom.tekst.map((p: string) => <p>{p}</p>)}
          </div>
          <div class="mt-8">
            <a href={localePath('/over-mij/', lang)} class="knop knop-rand">{waarom.knop}<Fragment set:html={pijl} /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Aanbod: hoe ik je kan begeleiden (4 overzichtelijke kaarten) -->
  <section class="licht relative bg-mos-100 pb-24 pt-24 text-woud-950 md:pb-28 md:pt-28" aria-labelledby="ceremonies-kop">
    <LeafEdge kleur="#f2e4c2" seed={31} />
    <div class="container-woud">
      <header class="maat-kop" data-groei>
        <h2 id="ceremonies-kop" class="sectie-kop text-woud-950">{home.ceremonies.kop}</h2>
        <p class="maat-tekst mt-4 text-[1.0625rem] leading-[1.75] text-woud-950/80">{home.ceremonies.tekst}</p>
      </header>

      <!-- Zelfde kaart als Ervaringen en Verhalen: kaart-licht, tekst boven, dunne lijn + rond icoon onder -->
      <ul class="raster mt-12 md:mt-14">
        {ceremonies.map((d: any) => (
          <li class="flex md:col-span-6" data-groei>
            <article class="aanbod kaart-licht relative flex h-full w-full flex-col justify-between p-7 md:p-8">
              <div>
                <h3 class="text-[1.4rem] leading-tight text-woud-950 md:text-[1.5rem]">
                  <a href={`${localePath('/ceremonies/', lang)}#${d.slug}`} class="aanbod-link no-underline">{d.titel}</a>
                </h3>
                <p class="maat-tekst mt-3 text-[1.02rem] leading-[1.75] text-woud-950/80">{d.kort}</p>
              </div>

              <footer class="mt-7 flex items-center gap-3 border-t border-jungle-800/12 pt-5" aria-hidden="true">
                <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-mos-200/75 text-jungle-800">
                  <Icoon naam={d.icoon as "truffel" | "paddenstoel" | "liaan" | "adem"} class="h-5 w-5" />
                </span>
                <span class="flex-1 text-sm font-semibold text-jungle-800">{home.ceremonies.kaartKnop}</span>
                <span class="aanbod-pijl inline-block h-4 w-4 text-jungle-800"><Fragment set:html={pijl} /></span>
              </footer>
            </article>
          </li>
        ))}
      </ul>

      <div class="mt-11 flex" data-groei>
        <a href={localePath('/ceremonies/', lang)} class="knop knop-rand">{home.ceremonies.knop}<Fragment set:html={pijl} /></a>
      </div>
    </div>
  </section>

  <!-- 5. Ervaringen van deelnemers -->
  <section class="relative bg-woud-800 pb-24 pt-24 md:pb-28 md:pt-28" aria-labelledby="ervaringen-kop">
    <LeafEdge kleur="#2e1e10" seed={59} omgekeerd />
    <div class="container-woud" data-groei>
      <Ervaringen kop={home.ervaringen.kop} lang={lang} />
    </div>
  </section>

  <!-- 6. Afsluiting: vrijblijvend kennismaken -->
  <section class="licht relative bg-dauw-50 pb-28 pt-20 text-woud-950 md:pb-36 md:pt-28" aria-labelledby="cta-kop">
    <LeafEdge kleur="#faf3e4" seed={71} />
    <div class="container-woud" data-groei>
      <div class="afsluiting">
        <Icoon naam="kiem" class="mx-auto h-10 w-10 text-jungle-800" />
        <h2 id="cta-kop" class="sectie-kop mt-3 text-balance text-woud-950">{cta.kop}</h2>
        <p class="afsluiting-tekst mt-4">{cta.tekst}</p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a href={localePath('/contact/', lang)} class="knop knop-zon">{cta.knop}<Fragment set:html={pijl} /></a>
          <a href={localePath('/intake/', lang)} class="knop knop-rand">{cta.intakeKnop}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Basis komt uit .kaart-licht (global.css); hier alleen de klikbare kaart */
  .aanbod { transition: box-shadow 0.5s var(--ease-adem); }
  .aanbod h3 { hyphens: auto; overflow-wrap: break-word; }
  .aanbod:hover { box-shadow: 0 10px 28px -16px rgb(46 30 16 / 0.14), inset 0 0 0 1px rgb(110 46 20 / 0.35); }
  .aanbod-link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .aanbod-link:focus-visible { outline: none; }
  .aanbod:has(.aanbod-link:focus-visible) { outline: 2px solid var(--jungle-800); outline-offset: 4px; }
  .aanbod-pijl { transition: transform 0.5s var(--ease-adem); }
  .aanbod:hover .aanbod-pijl { transform: translateX(4px); }
</style>
