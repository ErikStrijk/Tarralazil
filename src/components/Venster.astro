---
// Foto in een zachte, onregelmatige vorm. Vervang alleen de foto (src).
// Of geef een eigen <Image> mee als slot; dan worden src/alt genegeerd.
interface Props {
  src?: string;
  alt?: string;
  vorm?: 1 | 2 | 3 | 4;
  blad?: string;
  class?: string;
  laden?: 'lazy' | 'eager';
  breedte?: number;
  hoogte?: number;
}
const { src, alt, vorm = 1, class: cls = '', laden = 'lazy', breedte = 800, hoogte = 1000 } = Astro.props;

const vormen: Record<number, string> = {
  1: 'M9 5C31 1 66 3 91 4c4 0 7 4 7 9 1 24 0 49-1 73 0 6-3 9-9 10-26 2-53 3-77 0-5-1-8-4-8-9C1 63 2 37 3 13c0-4 2-7 6-8Z',
  2: 'M6 7C28 2 70 1 93 6c4 1 6 4 6 9-1 23 1 45-1 69-1 6-4 10-10 11-25 3-54 4-78 1-5-1-8-5-8-10C1 63 0 39 1 15c0-4 2-7 5-8Z',
  3: 'M11 3c25-2 54 0 78 2 6 1 9 4 9 10 0 25 1 48-1 71 0 6-4 10-10 10-26 2-52 2-77 1-5 0-8-4-8-9C1 64 1 38 3 13c0-6 3-9 8-10Z',
  4: 'M8 4c24-3 55-2 83 1 5 1 8 4 8 9 0 24-1 48-2 72 0 6-3 9-9 10-25 2-51 2-75 0-6 0-9-4-9-9C3 63 1 38 2 14c0-5 2-9 6-10Z',
};
const mask = `url("data:image/svg+xml,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' preserveAspectRatio='none'><path d='${vormen[vorm]}'/></svg>`)}")`;
---
<div class={`venster ${cls}`} style={`--venster-mask: ${mask}`}>
  {Astro.slots.has('default')
    ? <slot />
    : <img src={src} alt={alt ?? ''} loading={laden} decoding="async" width={breedte} height={hoogte} />}
</div>
