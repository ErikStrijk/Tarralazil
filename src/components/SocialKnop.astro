    .social-arrow,
    .mini-badge {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  function initSocialWidget() {
    const widget = document.querySelector<HTMLElement>('[data-social-widget]');
    const trigger = document.querySelector<HTMLButtonElement>('[data-social-trigger]');
    const popover = document.getElementById('social-popover');
    if (!widget || !trigger || !popover) return;

    let isOpen = false;

    const openPopover = () => {
      isOpen = true;
      popover.removeAttribute('hidden');
      popover.classList.add('is-open');
      trigger.classList.add('is-actief');
      trigger.setAttribute('aria-expanded', 'true');
    };

    const closePopover = () => {
      isOpen = false;
      popover.classList.remove('is-open');
      trigger.classList.remove('is-actief');
      trigger.setAttribute('aria-expanded', 'false');
      // Na transitie hidden attribuut zetten voor a11y
      setTimeout(() => {
        if (!isOpen) {
          popover.setAttribute('hidden', '');
        }
      }, 350);
    };

    const togglePopover = () => {
      if (isOpen) {
        closePopover();
      } else {
        openPopover();
      }
    };

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      togglePopover();
    });

    // Sluit bij klik buiten popover
    document.addEventListener('click', (e) => {
      if (isOpen && !widget.contains(e.target as Node)) {
        closePopover();
      }
    });

    // Sluit met Escape toets
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closePopover();
        trigger.focus();
      }
    });
  }

  // Initialiseer bij initial load en bij eventuele client-navigaties
  initSocialWidget();
  document.addEventListener('astro:page-load', initSocialWidget);
</script>
