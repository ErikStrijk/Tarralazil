---
import type { ImageMetadata } from 'astro';
import HeroFoto from './HeroFoto.astro';

interface Props {
  id?: string;
  eyebrow?: string;
  kop: string;
  tekst: string;
  beeld?: ImageMetadata;
  beeldPositie?: string;
  zachtBeeld?: boolean;
  groot?: boolean;
}

const {
  id = 'hero-kop',
  eyebrow,
  kop,
  tekst,
  beeld,
  beeldPositie,
  zachtBeeld = false,
  groot = false,
} = Astro.props;

const heeftActies = Astro.slots.has('acties');
const heeftRechts = Astro.slots.has('rechts');
---
<section
  class:list={[
    'relative isolate flex items-center overflow-hidden bg-woud-800 pb-20 pt-32',
    groot ? 'md:min-h-[80svh] md:pb-32 md:pt-40' : 'md:min-h-[46svh] md:pb-24 md:pt-40',
  ]}
  aria-labelledby={id}
>
  <HeroFoto beeld={beeld} positie={beeldPositie} zacht={zachtBeeld || heeftRechts} sterk={groot} />

  <div class="container-woud relative">
    {heeftRechts ? (
      <div class="raster items-center gap-y-10">
        <div class="maat-kop md:col-span-7">
          {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
          <h1 id={id} class="text-[clamp(2.15rem,4vw,3.45rem)] leading-[1.1] text-dauw-50">
            {kop}
          </h1>
          <p class="maat-tekst mt-5 text-[1.0625rem] leading-[1.75] text-dauw-200/95 md:text-[1.125rem]">
            {tekst}
          </p>
          {heeftActies && (
            <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
              <slot name="acties" />
            </div>
          )}
        </div>
        <div class="md:col-span-5">
          <slot name="rechts" />
        </div>
      </div>
    ) : (
      <div class="maat-kop">
        {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
        <h1 id={id} class="text-[clamp(2.15rem,4vw,3.45rem)] leading-[1.1] text-dauw-50">
          {kop}
        </h1>
        <p class="maat-tekst mt-5 text-[1.0625rem] leading-[1.75] text-dauw-200/95 md:text-[1.125rem]">
          {tekst}
        </p>
        {heeftActies && (
          <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
            <slot name="acties" />
          </div>
        )}
      </div>
    )}
  </div>
</section>
